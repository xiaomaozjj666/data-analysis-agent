# Recommended: native DeepSeek integration (V4.1 Flash)
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high

# Optional: OpenAI or another OpenAI-compatible service
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Agent controls
AGENT_TEMPERATURE=0
AGENT_MAX_ITERATIONS=25
AGENT_MAX_PLAN_STEPS=8
AGENT_TIMEOUT_SECONDS=120
DATA_AGENT_RUNS_DIR=./runs
DATA_AGENT_MAX_UPLOAD_BYTES=209715200
DATA_AGENT_MAX_ROWS=1000000
DATA_AGENT_MAX_CELLS=10000000
DATA_AGENT_MAX_ACTIVE_SESSIONS=100
DATA_AGENT_SESSION_TTL_HOURS=24
DATA_AGENT_RATE_LIMIT_PER_MINUTE=30
DATA_AGENT_MAX_CONCURRENT_ANALYSES=2
APP_ACCESS_TOKEN=

# Optional metric definitions registry: loaded during planning so the same
# metric keeps one definition across sessions (see README "指标口径登记")
DATA_AGENT_METRICS_PATH=

# Optional PostgreSQL data source for the query_database tool.
# When set, the agent can query this warehouse read-only (SELECT/WITH only;
# writes are refused server-side). Install the driver first: pip install ".[postgres]"
DATA_AGENT_DATABASE_URL=

# Optional persistent storage: Cloudflare R2 or another S3-compatible service
DATA_AGENT_STORAGE_BACKEND=local
DATA_AGENT_STORAGE_BUCKET=
DATA_AGENT_STORAGE_ENDPOINT_URL=
DATA_AGENT_STORAGE_PREFIX=data-analysis-agent/sessions
DATA_AGENT_R2_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# LangSmith observability and deployment
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=data-analysis-agent
LANGSMITH_WORKSPACE_ID=

# Local React development server
DATA_AGENT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
