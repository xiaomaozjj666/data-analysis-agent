# Recommended: native DeepSeek integration (V4.1 Flash)
MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_THINKING=true
DEEPSEEK_REASONING_EFFORT=high

# Optional: OpenAI or another OpenAI-compatible service
OPENAI_API_KEY=your-api-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_BASE_URL=

# Agent controls
AGENT_TEMPERATURE=0
AGENT_MAX_ITERATIONS=25
# 单个计划步骤内允许的工具调用次数上限。实测不设限时一步能跑到 23 次调用、
# 整轮 7 分钟；超出后本步直接结束并用已有结果写小结（可预期降级，不报错）。
AGENT_MAX_TOOL_CALLS_PER_STEP=6
# 单次分析的墙钟上限（秒）。超过后不再开新步骤，直接汇总已完成部分并说明原因
# ——实测同一句任务可能 230s 也可能 680s，没有上限时用户无法预期何时有结果。
AGENT_MAX_ANALYSIS_SECONDS=600
AGENT_MAX_PLAN_STEPS=8
AGENT_TIMEOUT_SECONDS=120
DATA_AGENT_RUNS_DIR=./runs
# 图表 CDN bundle（echarts / echarts-gl）的机器级共享缓存目录。
# 留空时用 <runs>/_bundles；多实例共享只读缓存时可指向公共目录。
DATA_AGENT_BUNDLE_CACHE_DIR=
DATA_AGENT_MAX_UPLOAD_BYTES=209715200
DATA_AGENT_MAX_ROWS=1000000
DATA_AGENT_MAX_CELLS=10000000
DATA_AGENT_MAX_ACTIVE_SESSIONS=100
DATA_AGENT_SESSION_TTL_HOURS=24
# CLI / MCP 每次运行都会在 runs/ 下新建 cli_* / mcp_* 目录；设为天数后，CLI 启动时自动清理更旧的目录（始终保留最新 10 个）。
# 留空或 0 = 不自动清理；也可随时手动运行：data-agent clean --dry-run
DATA_AGENT_CLI_RETENTION_DAYS=
DATA_AGENT_RATE_LIMIT_PER_MINUTE=30
# GET/HEAD 与健康/版本接口使用独立限流桶，避免页面轮询占用写请求配额。
DATA_AGENT_READ_RATE_LIMIT_PER_MINUTE=120
DATA_AGENT_HEALTH_RATE_LIMIT_PER_MINUTE=300
# Prometheus /metrics 默认开启且仅允许环回客户端；false 可完全关闭。
DATA_AGENT_METRICS_ENABLED=true
# Trusted reverse-proxy hops in front of this process, used to pick the client
# IP out of X-Forwarded-For for rate limiting. 0 (default) means direct
# exposure and XFF is ignored; set 1 when behind Render / Nginx.
DATA_AGENT_TRUSTED_PROXY_HOPS=0
DATA_AGENT_MAX_CONCURRENT_ANALYSES=2
APP_ACCESS_TOKEN=
# Optional read-only token: lets teammates view sessions/artifacts but rejects
# every write request with 403. If only this is set, the app runs read-only.
APP_VIEWER_TOKEN=
# Optional JSONL audit log for write/denied requests (no bodies, tokens or IPs).
# DATA_AGENT_AUDIT_LOG=./runs/audit.jsonl

# Prompt and report language, zh (default) or en
DATA_AGENT_LANGUAGE=zh

# Optional metric definitions registry: loaded during planning so the same
# metric keeps one definition across sessions (see README "指标口径登记")
DATA_AGENT_METRICS_PATH=

# Optional PostgreSQL data source for the query_database tool.
# When set, the agent can query this warehouse read-only (SELECT/WITH only;
# writes are refused server-side). Install the driver first: pip install ".[postgres]"
DATA_AGENT_DATABASE_URL=
# query_database 单条 SQL 墙钟预算（秒），范围 1-120，默认 30。
DATA_AGENT_SQL_TIMEOUT_SECONDS=30

# 定时任务告警邮件（可选）：连接信息只放环境变量，任务定义里只写收件人。
# URL 支持 smtp://（默认 STARTTLS，可用 ?starttls=0 关闭）与 smtps://（SSL）。
# DATA_AGENT_SMTP_URL=smtp://user:password@smtp.example.com:587
# DATA_AGENT_SMTP_FROM=alerts@example.com
# 定时任务告警短信（可选，Twilio REST API）；任务定义里只写 E.164 收件人。
# DATA_AGENT_TWILIO_ACCOUNT_SID=
# DATA_AGENT_TWILIO_AUTH_TOKEN=
# DATA_AGENT_TWILIO_FROM=+12025550123
# 技能包安装根目录（可选；默认项目级 ./.data-agent/skills、全局 ~/.data-agent/skills）
# DATA_AGENT_SKILLS_DIR=

# Optional persistent storage: Cloudflare R2 or another S3-compatible service
DATA_AGENT_STORAGE_BACKEND=local
DATA_AGENT_STORAGE_BUCKET=
DATA_AGENT_STORAGE_ENDPOINT_URL=
DATA_AGENT_STORAGE_PREFIX=data-analysis-agent/sessions
DATA_AGENT_R2_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto

# LangSmith observability and deployment
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=your-langsmith-api-key
LANGSMITH_PROJECT=data-analysis-agent
LANGSMITH_WORKSPACE_ID=

# Local React development server
DATA_AGENT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 前端构建产物目录。源码树内运行时默认 <repo>/frontend/dist；
# 以 wheel 安装到 site-packages 或在容器 / Render 中运行时必须显式指定，
# 否则无法从 __file__ 反推仓库根，SPA 会返回 404。
DATA_AGENT_STATIC_DIR=
