# 所有环境变量文件（.env / .env.production / .env.test / frontend/.env.*）都不入库，
# 只保留示例文件，避免真实密钥被误提交。
.env*
!.env.example
runs/
# 现场证据包（scripts/prepare_demo_evidence.py 生成）：含原始数据与账本，只留本机。
evidence/
.playwright-cli/
.pw-browsers/
_test_screenshots/
.ruff_cache/
.langgraph_api/
output/
/dist/
build/
*.egg-info/
frontend/node_modules/
.vitest-cache/
frontend/.vite/
# 前端构建产物：由 `npm run build` / Dockerfile 前端阶段生成，运行时由
# FastAPI 从磁盘静态托管，无需入库（避免每次改动产生哈希重命名的大 diff）。
frontend/dist/

# 测试临时目录与并发覆盖率文件
.pytest-*/
.coverage.*

